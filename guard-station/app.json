{
  "expo": {
    "name": "GuardStation",
    "slug": "guard-station",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "guardstation",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.renovopros.guardstation"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F203A"
      },
      "package": "com.renovopros.guardstation",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F203A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Guard Station needs camera access to capture ID and vehicle photos at entry."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
