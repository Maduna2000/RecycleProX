// RecycleProX Basic — Prisma Schema
// All monetary values: Decimal(18,2) — HARD RULE
// All IDs: UUID — never auto-increment for business records

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  manager
  cashier
  scale_operator
}

enum ScaleOrderStatus {
  pending
  processed
  voided
}

enum CustomerType {
  casual
  account
}

enum TxStatus {
  pending
  completed
  voided
}

enum PaymentMethod {
  cash
  eft
  cheque
  amplopay
}

enum ProductCategory {
  ferrous
  non_ferrous
  copper
  aluminium
  plastic
  paper
  e_waste
  other
}

enum UnitOfMeasure {
  kg
  ton
  each
  litre
}

enum StockDirection {
  in
  out
}


enum PrimaryFunction {
  customer
  supplier
  both
}

enum Gender {
  male
  female
  other
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
  VOID
  LOGIN
  LOGOUT
  PRINT
  EXPORT
  ADJUSTMENT
}

enum MarketSector {
  formal
  informal
}

enum DealerCategory {
  casual
  dealer_1
  dealer_2
  dealer_3
}

enum CustomerDocumentType {
  trading_licence
  sars_certificate
  company_registration
  id_copy
  other
}

enum FloatMovementType {
  opening
  top_up
  withdrawal
  adjustment
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(uuid())
  fullName             String
  username             String    @unique
  passwordHash         String
  pinHash              String?
  role                 UserRole
  isActive             Boolean   @default(true)
  forcePasswordChange  Boolean   @default(true)
  failedAttempts       Int       @default(0)
  lockedAt             DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdByUserId      String?

  stocktakes              Stocktake[]  @relation("StocktakeCreatedBy")
  operatedScaleOrders     ScaleOrder[] @relation("ScaleOrderOperator")
  voidedScaleOrders       ScaleOrder[] @relation("ScaleOrderVoidedBy")
}

model AuditLog {
  id          BigInt      @id @default(autoincrement())
  tableName   String
  recordId    String
  action      AuditAction
  oldValues   Json?
  newValues   Json?
  changedById String?
  ipAddress   String?
  userAgent   String?
  rowHash     String
  createdAt   DateTime    @default(now())

  @@index([tableName, recordId])
  @@index([changedById])
  @@index([createdAt])
}

model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Customer {
  id               String          @id @default(uuid())
  customerType     CustomerType    @default(casual)
  primaryFunction  PrimaryFunction @default(supplier)
  idNumber         String?         @unique
  firstName        String
  lastName         String
  dateOfBirth      DateTime?
  gender           Gender?
  nationality      String?
  accountCode      String?         @unique
  companyName      String?
  companyRegNumber String?
  contactPerson    String?
  phone            String
  landline         String?
  email            String?
  physicalAddress  String?
  postalAddress    String?
  vatNumber        String?
  bankName         String?
  bankAccountNo    String?
  bankBranchCode   String?
  creditLimit      Decimal?        @db.Decimal(18, 2)
  policeRegisterNo String?
  licenseNumber    String?
  licenseExpiry    DateTime?
  tradeCommodities Json?           // String[] e.g. ["Copper","Aluminium","Steel"]
  customerNotes    String?
  idPhotoR2Key     String?
  priceGroupId     String?
  priceGroup       PriceGroup?     @relation(fields: [priceGroupId], references: [id])
  purchases        Purchase[]
  sales            Sale[]     @relation("SaleCustomer")
  payments         Payment[]
  loans            Loan[]
  loanRepayments   LoanRepayment[]
  marketSector     MarketSector?
  dealerCategory   DealerCategory?
  zeroRated        Boolean         @default(false)
  isActive         Boolean         @default(true)
  blacklisted      Boolean         @default(false)
  blacklistReason  String?
  blacklistedAt    DateTime?
  blacklistedById  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdByUserId  String?

  documents            CustomerDocument[]
  transactionPayments  TransactionPayment[]
  scaleOrders          ScaleOrder[]

  @@index([idNumber])
  @@index([phone])
  @@index([lastName])
  @@index([customerType])
  @@index([companyName])
  @@index([contactPerson])
}

model CustomerDocument {
  id               String               @id @default(uuid())
  customerId       String
  customer         Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  documentType     CustomerDocumentType
  r2Key            String
  fileName         String
  notes            String?
  uploadedAt       DateTime             @default(now())
  uploadedByUserId String?

  @@index([customerId])
}

// ─── Products & Pricing ───────────────────────────────────────────────────────

model Product {
  id               String          @id @default(uuid())
  code             String          @unique
  name             String
  category         ProductCategory
  unit             UnitOfMeasure   @default(kg)
  defaultBuyPrice  Decimal         @db.Decimal(18, 2)
  defaultSellPrice Decimal         @db.Decimal(18, 2)
  buyMarginPct     Decimal?        @db.Decimal(8, 4)    // display-only margin %
  minStockLevel    Decimal?        @db.Decimal(18, 3)
  isActive         Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  priceOverrides      PriceGroupProductOverride[]
  priceHistory        PriceHistory[]
  purchaseLines       PurchaseLine[]
  saleLines           SaleLine[]
  stockMovements      StockMovement[]
  stocktakeEntries    StocktakeEntry[]

  @@index([category])
  @@index([isActive])
}

model PriceGroup {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customers   Customer[]
  overrides   PriceGroupProductOverride[]
}

model PriceGroupProductOverride {
  id           String     @id @default(uuid())
  priceGroupId String
  productId    String
  buyPrice     Decimal    @db.Decimal(18, 2)
  sellPrice    Decimal    @db.Decimal(18, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  priceGroup   PriceGroup @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceGroupId, productId])
  @@index([productId])
}

model PriceHistory {
  id          String   @id @default(uuid())
  productId   String
  buyPrice    Decimal  @db.Decimal(18, 2)
  sellPrice   Decimal  @db.Decimal(18, 2)
  changedById String?
  reason      String?
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

// ─── Purchases (M5) ───────────────────────────────────────────────────────────

model Purchase {
  id              String        @id @default(uuid())
  refNumber       String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  status          TxStatus      @default(completed)
  totalAmount     Decimal       @db.Decimal(18, 2)
  paymentMethod   PaymentMethod @default(cash)
  notes           String?
  loanDeductionAmount  Decimal?      @db.Decimal(18, 2)
  amountPaid           Decimal       @default(0) @db.Decimal(18, 2)
  signatureR2Key       String?
  vat264R2Key          String?
  purchaseNoteR2Key    String?
  photoR2Keys          String[]
  vehicleReg           String?
  wbTicketNumber       String?
  pdfEmailed           Boolean       @default(false)
  hasOutstandingBalance Boolean      @default(false)
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines                 PurchaseLine[]
  loanRepayments        LoanRepayment[]
  transactionPaymentLinks TransactionPaymentLink[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([refNumber])
  @@index([customerId, status, createdAt])
}

model PurchaseLine {
  id           String   @id @default(uuid())
  purchaseId   String
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Decimal  @db.Decimal(18, 3)   // net weight (gross - tare)
  grossQty     Decimal? @db.Decimal(18, 3)   // raw scale reading
  tareQty      Decimal? @db.Decimal(18, 3)   // tare deduction
  tareReason   String?                        // e.g. "Bag", "Pallet", "Container"
  unitPrice    Decimal  @db.Decimal(18, 2)
  lineTotal    Decimal  @db.Decimal(18, 2)
  priceSource     String   @default("default")
  deductionQty    Decimal? @db.Decimal(18, 3)   // quantity deducted (e.g. contamination, damage)
  deductionReason String?                        // reason for deduction
  createdAt       DateTime @default(now())

  @@index([purchaseId])
  @@index([productId])
}

// ─── Sales (M6) ───────────────────────────────────────────────────────────────

model Sale {
  id              String        @id @default(uuid())
  refNumber       String        @unique
  buyerId         String?
  buyerName       String?
  buyerIdNumber   String?
  buyerPhone      String?
  customerId      String?
  customer        Customer?     @relation("SaleCustomer", fields: [customerId], references: [id])
  status          TxStatus      @default(completed)
  totalAmount     Decimal       @db.Decimal(18, 2)
  paymentMethod   PaymentMethod @default(cash)
  notes           String?
  photoR2Key      String?       // optional camera capture during sale
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines           SaleLine[]

  @@index([buyerId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([refNumber])
}

model SaleLine {
  id          String   @id @default(uuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Decimal  @db.Decimal(18, 3)
  unitPrice   Decimal  @db.Decimal(18, 2)
  lineTotal   Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

// ─── Stock (M8) ───────────────────────────────────────────────────────────────

model StockMovement {
  id              String         @id @default(uuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  direction       StockDirection
  quantity        Decimal        @db.Decimal(18, 3)
  source          String         // 'purchase' | 'sale' | 'manual_adjustment' | 'void_reversal'
  sourceId        String?        // purchaseId / saleId for traceability
  notes           String?
  createdByUserId String?
  createdAt       DateTime       @default(now())

  @@index([productId])
  @@index([direction])
  @@index([source])
  @@index([createdAt])
  @@index([productId, createdAt])
}

// ─── Payments (M7) ────────────────────────────────────────────────────────────
// Payments made OUT to account customers settling their purchase balance.

model Payment {
  id              String        @id @default(uuid())
  refNumber       String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  amount          Decimal       @db.Decimal(18, 2)
  paymentMethod   PaymentMethod @default(cash)
  notes           String?
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([customerId])
  @@index([createdAt])
  @@index([refNumber])
}

// ─── Expenses (M15) ───────────────────────────────────────────────────────────

enum ExpenseStatus {
  pending
  approved
  voided
}

model ExpenseType {
  id        String        @id @default(uuid())
  name      String        @unique
  parentId  String?
  parent    ExpenseType?  @relation("children", fields: [parentId], references: [id])
  children  ExpenseType[] @relation("children")
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  expenses  Expense[]

  @@index([parentId])
}

model Expense {
  id              String        @id @default(uuid())
  refNumber       String        @unique
  expenseTypeId   String
  expenseType     ExpenseType   @relation(fields: [expenseTypeId], references: [id])
  description     String
  amount          Decimal       @db.Decimal(18, 2)
  vatAmount       Decimal       @db.Decimal(18, 2) @default(0)
  includesVat     Boolean       @default(false)
  paymentMethod   PaymentMethod @default(cash)
  chequeNo        String?
  status          ExpenseStatus @default(pending)
  approvedById    String?
  approvedAt      DateTime?
  cashUpId        String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  attachments     ExpenseAttachment[]

  @@index([expenseTypeId])
  @@index([status])
  @@index([createdAt])
}

model ExpenseAttachment {
  id               String   @id @default(uuid())
  expenseId        String
  expense          Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  r2Key            String
  fileName         String
  notes            String?
  uploadedAt       DateTime @default(now())
  uploadedByUserId String?

  @@index([expenseId])
}

// ─── Float (M16) ──────────────────────────────────────────────────────────────

model CashFloat {
  id              String   @id @default(uuid())
  floatDate       DateTime @db.Date
  openingAmount   Decimal  @db.Decimal(18, 2)
  closingAmount   Decimal? @db.Decimal(18, 2)
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  movements       FloatMovement[]

  @@unique([floatDate])
  @@index([floatDate])
}

// ─── Cash-up (M10) ────────────────────────────────────────────────────────────

enum CashUpStatus {
  open
  submitted
  approved
}

// ─── Stocktake (M6 / Phase 6) ────────────────────────────────────────────────

enum StocktakeStatus {
  open
  completed
}

model Stocktake {
  id              String          @id @default(uuid())
  refNumber       String          @unique
  status          StocktakeStatus @default(open)
  notes           String?
  createdByUserId String
  createdBy       User            @relation("StocktakeCreatedBy", fields: [createdByUserId], references: [id])
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  entries         StocktakeEntry[]

  @@index([status])
  @@index([createdAt])
}

model StocktakeEntry {
  id           String    @id @default(uuid())
  stocktakeId  String
  stocktake    Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  systemQty    Decimal   @db.Decimal(18, 4)
  countedQty   Decimal   @db.Decimal(18, 4)  // net (gross - tare)
  grossQty     Decimal?  @db.Decimal(18, 4)  // raw scale reading
  tareQty      Decimal?  @db.Decimal(18, 4)  // tare deduction
  photoR2Key   String?                        // scale snapshot photo
  variance     Decimal   @db.Decimal(18, 4)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([stocktakeId, productId])
  @@index([stocktakeId])
  @@index([productId])
}

model CashUp {
  id                  String        @id @default(uuid())
  sessionDate         DateTime      @db.Date
  openedByUserId      String
  openedAt            DateTime      @default(now())
  closedByUserId      String?
  closedAt            DateTime?
  approvedByUserId    String?
  approvedAt          DateTime?
  status              CashUpStatus  @default(open)

  // System-calculated totals (from DB at close time)
  systemCashSales     Decimal       @db.Decimal(18, 2) @default(0)
  systemCashPurchases Decimal       @db.Decimal(18, 2) @default(0)
  systemCashPayments  Decimal       @db.Decimal(18, 2) @default(0)
  systemCashExpected  Decimal       @db.Decimal(18, 2) @default(0)

  // Financial reconciliation fields (Phase 4)
  openingBalance      Decimal       @db.Decimal(18, 2) @default(0)
  drawingsReceived    Decimal       @db.Decimal(18, 2) @default(0)
  expensesTotal       Decimal       @db.Decimal(18, 2) @default(0)
  cardPaymentsTotal   Decimal       @db.Decimal(18, 2) @default(0)
  loansTotal          Decimal       @db.Decimal(18, 2) @default(0)
  finPeriodCumulative Decimal       @db.Decimal(18, 2) @default(0)

  // Cashier-declared physical count
  declaredCash        Decimal?      @db.Decimal(18, 2)
  variance            Decimal?      @db.Decimal(18, 2)
  notes               String?

  // Denomination breakdown (JSON: { "200": 3, "100": 5, ... })
  denominations       Json?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([sessionDate])
  @@index([status])
  @@index([openedByUserId])
}

// ─── Loans (Feature 10) ───────────────────────────────────────────────────────

enum LoanStatus {
  active
  settled
  voided
}

model Loan {
  id              String        @id @default(uuid())
  refNumber       String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  principalAmount Decimal       @db.Decimal(18, 2)
  balanceAmount   Decimal       @db.Decimal(18, 2)
  paymentMethod   PaymentMethod @default(cash)
  notes           String?
  status          LoanStatus    @default(active)
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  repayments      LoanRepayment[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model LoanRepayment {
  id              String        @id @default(uuid())
  refNumber       String        @unique
  loanId          String
  loan            Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  purchaseId      String?
  purchase        Purchase?     @relation(fields: [purchaseId], references: [id])
  amount          Decimal       @db.Decimal(18, 2)
  paymentMethod   PaymentMethod @default(cash)
  notes           String?
  createdByUserId String?
  createdAt       DateTime      @default(now())

  @@index([loanId])
  @@index([customerId])
  @@index([purchaseId])
  @@index([createdAt])
}

// ─── Police Visits (Feature 8) ────────────────────────────────────────────────

model PoliceVisit {
  id              String    @id @default(uuid())
  visitDate       DateTime  @db.Date
  officerName     String
  badgeNumber     String?
  stationName     String?
  registerR2Key   String?
  signatureR2Key  String?
  notes           String?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  @@index([visitDate])
  @@index([createdAt])
}

// ─── Media Files (centralized R2 media registry) ─────────────────────────────

model MediaFile {
  id               String   @id @default(uuid())
  r2Key            String   @unique
  fileName         String
  mimeType         String
  fileSizeBytes    Int?
  linkedModel      String   // e.g. "Purchase", "Customer", "Sale", "StocktakeEntry"
  linkedId         String   // UUID of the linked record
  mediaType        String   // "signature" | "id_photo" | "vat264" | "purchase_note" | "scale_photo" | "other"
  uploadedByUserId String?
  uploadedAt       DateTime @default(now())

  @@index([linkedModel, linkedId])
  @@index([uploadedAt])
}

// ─── Float Movements (ledger for CashFloat top-ups / withdrawals) ────────────

model FloatMovement {
  id               String            @id @default(uuid())
  cashFloatId      String
  cashFloat        CashFloat         @relation(fields: [cashFloatId], references: [id], onDelete: Cascade)
  movementType     FloatMovementType
  amount           Decimal           @db.Decimal(18, 2)
  balanceAfter     Decimal           @db.Decimal(18, 2)
  referenceNote    String?
  createdByUserId  String?
  createdAt        DateTime          @default(now())

  @@index([cashFloatId])
  @@index([createdAt])
}

// ─── Transaction Payments (multi-ticket payment batching) ────────────────────

model TransactionPayment {
  id               String                  @id @default(uuid())
  refNumber        String                  @unique
  customerId       String
  customer         Customer                @relation(fields: [customerId], references: [id])
  totalAmount      Decimal                 @db.Decimal(18, 2)
  paymentMethod    PaymentMethod           @default(cash)
  notes            String?
  createdByUserId  String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  purchaseLinks    TransactionPaymentLink[]

  @@index([customerId])
  @@index([createdAt])
}

model TransactionPaymentLink {
  id                   String             @id @default(uuid())
  transactionPaymentId String
  transactionPayment   TransactionPayment @relation(fields: [transactionPaymentId], references: [id], onDelete: Cascade)
  purchaseId           String
  purchase             Purchase           @relation(fields: [purchaseId], references: [id])
  amountAllocated      Decimal            @db.Decimal(18, 2)
  createdAt            DateTime           @default(now())

  @@unique([transactionPaymentId, purchaseId])
  @@index([purchaseId])
}

// ─── Scale Station ────────────────────────────────────────────────────────────

model ScaleCategory {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  colorHex    String?
  iconName    String?
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  products    ScaleProduct[]
}

model ScaleProduct {
  id         String        @id @default(uuid())
  categoryId String
  name       String
  unit       UnitOfMeasure @default(kg)
  isActive   Boolean       @default(true)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  category   ScaleCategory @relation(fields: [categoryId], references: [id])
  orders     ScaleOrder[]

  @@index([categoryId])
}

model ScaleOrder {
  id              String           @id @default(uuid())
  orderNumber     String           @unique
  customerId      String?
  casualFirstName String?
  casualLastName  String?
  casualPhone     String?
  productId       String
  weight          Decimal          @db.Decimal(18, 3)
  photoR2Keys     String[]
  slipR2Key       String?
  status          ScaleOrderStatus @default(pending)
  operatorId      String
  notes           String?
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  customer   Customer?     @relation(fields: [customerId], references: [id])
  product    ScaleProduct  @relation(fields: [productId], references: [id])
  operator   User          @relation("ScaleOrderOperator", fields: [operatorId], references: [id])
  voidedBy   User?         @relation("ScaleOrderVoidedBy", fields: [voidedById], references: [id])

  @@index([customerId])
  @@index([productId])
  @@index([operatorId])
  @@index([status])
  @@index([createdAt])
}
