  createdAt   DateTime   @default(now())
  order       ScaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product    @relation("ScaleOrderLineProduct", fields: [productId], references: [id])

  @@index([tenantId])
  @@index([tenantId, orderId])
  @@index([tenantId, productId])
}

// Gate Security — yard entry/exit log. customerId is set only on an exact
// ID-number match against an existing Customer; unlike ScaleOrder's
// quickCreate-on-create behaviour, a non-matching visitor is never turned
// into a new Customer row here — the visitor* fields carry their details
// inline regardless. "Repeat visitor" is detected by matching
// visitorIdNumber against this table's own history, so it works whether or
// not the person has ever become a real Customer.
model GateEntry {
  id                String           @id @default(uuid())
  tenantId          String
  entryNumber       String
  purpose           GateEntryPurpose
  categoryNames     String[]         @default([])
  customerId        String?
  visitorFirstName  String
  visitorLastName   String
  visitorIdNumber   String
  visitorPhone      String?
  vehicleReg        String?
  idPhotoR2Key      String?
  vehiclePhotoR2Key String?
  facePhotoR2Key    String?
  notes             String?
  operatorId        String
  exitedAt          DateTime?
  exitedById        String?
  createdAt         DateTime         @default(now())
  // Queue number for the Scale Station — only set for purpose === 'sell'
  // (the only visits that actually go weigh something in). Sequential per
  // tenant per day, generated the same way entryNumber is (counted inside
  // the same create transaction). queueNumberUsedAt is set atomically by
  // createScaleOrder() when a scale order is actually created from it —
  // a lookup alone never consumes it, only a submitted order does.
  queueNumber       Int?
  queueNumberUsedAt DateTime?
  customer          Customer?        @relation(fields: [customerId], references: [id])
  operator          User             @relation("GateEntryOperator", fields: [operatorId], references: [id])
  exitedBy          User?            @relation("GateEntryExitedBy", fields: [exitedById], references: [id])
  scaleOrders       ScaleOrder[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId])
  @@index([tenantId, visitorIdNumber])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@index([tenantId, exitedAt])
}

// Per-purpose photo requirements, admin-configurable — mirrors
// CategoryStepConfig's role for Scale Station, but keyed on purpose
// (Gate Entry's natural branching axis) rather than product category.
model GatePurposeConfig {
  id                  String           @id @default(uuid())
  tenantId            String
  purpose             GateEntryPurpose
  requireIdPhoto      Boolean          @default(false)
  requireVehiclePhoto Boolean          @default(true)
  requireFacePhoto    Boolean          @default(true)

  @@unique([tenantId, purpose])
  @@index([tenantId])
}

// Admin-managed picklist a guard chooses from at the "what are they selling?"
// step — deliberately independent of ProductCategory (that catalogue is for
// the actual purchase/weighing transaction later; this is just a heads-up
// tag on the visitor log). Flat list, no hierarchy — mirrors ProductCategory's
// shape (name/colorHex/iconName/sortOrder/isActive) minus parent/child.
model GateSellOption {
  id        String   @id @default(uuid())
  tenantId  String
  label     String
  colorHex  String?
  iconName  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, label])
  @@index([tenantId])
}

