generator client {
  provider      = "prisma-client-js"
  // "windows" is explicit (not left to "native") because the desktop build
  // (electron/main.js) spawns this same client inside a packaged Windows
  // app — "native" only resolves correctly when `prisma generate` itself
  // runs on Windows, which is fragile to depend on: a build produced from
  // any other OS would silently ship a query engine the target PC can't
  // load, and every DB-touching route (including login) would 500.
  binaryTargets = ["native", "windows", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cross-tenant registry — lives only in the `public` schema, never inside a
// per-tenant schema. Resolves a login subdomain/slug to the Postgres schema
// that holds that company's business data (see src/lib/db/registryPrisma.ts).
//
// schemaName is vestigial post shared-table migration (kept through the
// rollback window, see i-need-you-to-vectorized-pumpkin.md Section 9) — the
// live isolation mechanism is now tenantId + RLS, not a Postgres schema.
model Tenant {
  id           String       @id @default(uuid())
  companySlug  String       @unique
  schemaName   String       @unique
  companyName  String
  status       TenantStatus @default(active)
  planCode     String?
  featureFlags Json?
  graceEndsAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Cache of the last successful Portal access check (companyAccessClient.ts)
  // — backs login()'s bounded fail-open window when the Portal is
  // unreachable, so routine shift logins don't hinge on cross-service
  // uptime, while still failing closed once the cache goes stale.
  lastAccessCheckAt     DateTime?
  lastAccessCheckResult Json?
}

enum TenantStatus {
  active
  suspended
  provisioning
}

model User {
  id                  String             @id @default(uuid())
  tenantId            String
  fullName            String
  username            String
  passwordHash        String
  pinHash             String?
  role                UserRole
  isActive            Boolean            @default(true)
  forcePasswordChange Boolean            @default(true)
  failedAttempts      Int                @default(0)
  lockedAt            DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  createdByUserId     String?
  operatedScaleOrders ScaleOrder[]       @relation("ScaleOrderOperator")
  voidedScaleOrders   ScaleOrder[]       @relation("ScaleOrderVoidedBy")
  stocktakes          Stocktake[]        @relation("StocktakeCreatedBy")
  voidedStocktakes    Stocktake[]        @relation("StocktakeVoidedBy")
  operatedGateEntries GateEntry[]        @relation("GateEntryOperator")
  exitedGateEntries   GateEntry[]        @relation("GateEntryExitedBy")
  moduleAccess        UserModuleAccess[]

  @@unique([tenantId, username])
  @@index([tenantId])
}

model UserModuleAccess {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  moduleKey   String
  grantedById String?
  grantedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, moduleKey])
  @@index([tenantId])
  @@index([userId])
  @@index([moduleKey])
}

model AuditLog {
  id          BigInt      @id @default(autoincrement())
  tenantId    String
  tableName   String
  recordId    String
  action      AuditAction
  oldValues   Json?
  newValues   Json?
  changedById String?
  ipAddress   String?
  userAgent   String?
  rowHash     String
  createdAt   DateTime    @default(now())

  @@index([tenantId])
  @@index([tenantId, tableName, recordId])
  @@index([tenantId, changedById])
  @@index([tenantId, createdAt])
}

model SystemSettings {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Customer {
  id                     String                  @id @default(uuid())
  tenantId               String
  customerType           CustomerType            @default(casual)
  primaryFunction        PrimaryFunction         @default(supplier)
  idNumber               String?
  firstName              String
  lastName               String
  dateOfBirth            DateTime?
  gender                 Gender?
  nationality            String?
  companyName            String?
  contactPerson          String?
  phone                  String
  email                  String?
  physicalAddress        String?
  postalAddress          String?
  vatNumber              String?
  bankName               String?
  bankAccountNo          String?
  bankBranchCode         String?
  creditLimit            Decimal?                @db.Decimal(18, 2)
  policeRegisterNo       String?
  licenseNumber          String?
  licenseExpiry          DateTime?
  tradeCommodities       Json?
  customerNotes          String?
  idPhotoR2Key           String?
  priceGroupId           String?
  isActive               Boolean                 @default(true)
  blacklisted            Boolean                 @default(false)
  blacklistReason        String?
  blacklistedAt          DateTime?
  blacklistedById        String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  createdByUserId        String?
  dealerCategory         DealerCategory?
  marketSector           MarketSector?
  zeroRated              Boolean                 @default(true)
  accountCode            String?
  companyRegNumber       String?
  landline               String?
  priceGroup             PriceGroup?             @relation(fields: [priceGroupId], references: [id])
  documents              CustomerDocument[]
  loans                  Loan[]
  loanRepayments         LoanRepayment[]
  businessLoans          BusinessLoan[]
  businessLoanRepayments BusinessLoanRepayment[]
  payments               Payment[]
  purchases              Purchase[]
  sales                  Sale[]                  @relation("SaleCustomer")
  scaleOrders            ScaleOrder[]
  gateEntries            GateEntry[]
  transactionPayments    TransactionPayment[]

  @@unique([tenantId, idNumber])
  @@unique([tenantId, accountCode])
  @@index([tenantId])
  @@index([tenantId, idNumber])
  @@index([tenantId, phone])
  @@index([tenantId, lastName])
  @@index([tenantId, customerType])
  @@index([tenantId, companyName])
  @@index([tenantId, contactPerson])
}

model CustomerDocument {
  id               String               @id @default(uuid())
  tenantId         String
  customerId       String
  documentType     CustomerDocumentType
  r2Key            String
  fileName         String
  notes            String?
  uploadedAt       DateTime             @default(now())
  uploadedByUserId String?
  customer         Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, customerId])
}

model Product {
  id               String                      @id @default(uuid())
  tenantId         String
  code             String
  name             String
  category         String
  categoryId       String?
  unit             UnitOfMeasure               @default(kg)
  defaultBuyPrice  Decimal                     @db.Decimal(18, 2)
  defaultSellPrice Decimal                     @db.Decimal(18, 2)
  isActive         Boolean                     @default(true)
  sortOrder        Int                         @default(0)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  minStockLevel    Decimal?                    @db.Decimal(18, 3)
  buyMarginPct     Decimal?                    @db.Decimal(8, 4)
  categoryRef      ProductCategory?            @relation("ProductCategoryProducts", fields: [categoryId], references: [id])
  priceOverrides   PriceGroupProductOverride[]
  priceHistory     PriceHistory[]
  priceListItems   PriceListItem[]
  purchaseLines    PurchaseLine[]
  saleLines        SaleLine[]
  scaleOrders      ScaleOrder[]                @relation("ScaleOrderProduct")
  scaleOrderLines  ScaleOrderLine[]            @relation("ScaleOrderLineProduct")
  stockMovements   StockMovement[]
  stocktakeEntries StocktakeEntry[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, categoryId])
  @@index([tenantId, isActive])
}

model PriceGroup {
  id          String                      @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isDefault   Boolean                     @default(false)
  isActive    Boolean                     @default(true)
  // Stable link for dealer-tier auto-pricing (customerService.resolvePriceGroupId) —
  // set once on the seeded Dealer 1/2/3 groups so renaming the group's display
  // name can never silently break price resolution the way it did before
  // (see project memory: 269 Dealer-1 customers mispriced). Never set for
  // non-dealer-tier groups.
  dealerTier  DealerCategory?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  customers   Customer[]
  overrides   PriceGroupProductOverride[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, dealerTier])
}

model PriceGroupProductOverride {
  id           String     @id @default(uuid())
  tenantId     String
  priceGroupId String
  productId    String
  buyPrice     Decimal    @db.Decimal(18, 2)
  sellPrice    Decimal    @db.Decimal(18, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  priceGroup   PriceGroup @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, priceGroupId, productId])
  @@index([tenantId])
  @@index([tenantId, productId])
}

model PriceHistory {
  id          String   @id @default(uuid())
  tenantId    String
  productId   String
  buyPrice    Decimal  @db.Decimal(18, 2)
  sellPrice   Decimal  @db.Decimal(18, 2)
  changedById String?
  reason      String?
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
}

model PriceList {
  id                   String          @id @default(uuid())
  tenantId             String
  title                String          @default("TODAY'S PRICES")
  listDate             DateTime
  footerText           String          @default("Prices subject to change without notice. VAT rate applied as per current legislation.")
  showLogo             Boolean         @default(true)
  showExVat            Boolean         @default(true)
  // Print palette — hex strings (#RRGGBB), defaults matching the original
  // fixed navy/gold scheme so existing documents render unchanged.
  primaryColor         String          @default("#1B3A6B")
  accentColor          String          @default("#C9A227")
  headerTextColor      String          @default("#FFFFFF")
  materialTextColor    String          @default("#121212")
  priceTextColor       String          @default("#1B3A6B")
  exVatTextColor       String          @default("#737373")
  rowTintColor         String          @default("#E6EBF5")
  isActiveForPurchases Boolean         @default(false)
  createdByUserId      String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  items                PriceListItem[]

  @@index([tenantId])
  @@index([tenantId, isActiveForPurchases])
}

model PriceListItem {
  id          String    @id @default(uuid())
  tenantId    String
  priceListId String
  productId   String?
  displayName String
  // Snapshotted at add-time from the product's category (or "Other" for a
  // custom line) — drives the printed category divider bars. Independent of
  // the live Product record, same as displayName/priceIncVat.
  category    String    @default("Other")
  priceIncVat Decimal   @db.Decimal(18, 2)
  sortOrder   Int       @default(0)
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, priceListId])
}

model ProductCategory {
  id               String              @id @default(uuid())
  tenantId         String
  name             String
  colorHex         String?
  sortOrder        Int                 @default(0)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  iconName         String?
  parentId         String?
  // Enables this category as a selectable "trade commodity" option on
  // account-customer registration — see productService.ts's
  // listTradeCommodityOptions/setTradeCommodityFlag. Superseded the standalone
  // TradeCommodityCategory model (free-typed names, prone to drifting from
  // real product categories) on 2026-07-18.
  isTradeCommodity Boolean             @default(false)
  stepConfig       CategoryStepConfig?
  parent           ProductCategory?    @relation("SubCategories", fields: [parentId], references: [id])
  children         ProductCategory[]   @relation("SubCategories")
  products         Product[]           @relation("ProductCategoryProducts")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model CategoryStepConfig {
  id              String          @id @default(uuid())
  tenantId        String
  categoryId      String          @unique
  requireWeight   Boolean         @default(true)
  requirePhotos   Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdByUserId String?
  category        ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, categoryId])
}

model Purchase {
  id                      String                   @id @default(uuid())
  tenantId                String
  refNumber               String
  customerId              String
  status                  TxStatus                 @default(completed)
  totalAmount             Decimal                  @db.Decimal(18, 2)
  vatAmount               Decimal?                 @db.Decimal(18, 2)
  paymentMethod           PaymentMethod            @default(cash)
  notes                   String?
  voidedAt                DateTime?
  voidedById              String?
  voidReason              String?
  createdByUserId         String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  signatureR2Key          String?
  vat264R2Key             String?
  loanDeductionAmount     Decimal?                 @db.Decimal(18, 2)
  photoR2Keys             String[]
  amountPaid              Decimal                  @default(0) @db.Decimal(18, 2)
  hasOutstandingBalance   Boolean                  @default(false)
  pdfEmailed              Boolean                  @default(false)
  purchaseNoteR2Key       String?
  vehicleReg              String?
  wbTicketNumber          String?
  splitPayments           Json?
  scaleOrderId            String?                  @unique
  loanRepayments          LoanRepayment[]
  payments                Payment[]
  customer                Customer                 @relation(fields: [customerId], references: [id])
  scaleOrder              ScaleOrder?              @relation(fields: [scaleOrderId], references: [id])
  lines                   PurchaseLine[]
  transactionPaymentLinks TransactionPaymentLink[]

  @@unique([tenantId, refNumber])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId, status, createdAt])
}

model PurchaseLine {
  id              String   @id @default(uuid())
  tenantId        String
  purchaseId      String
  productId       String
  quantity        Decimal  @db.Decimal(18, 3)
  unitPrice       Decimal  @db.Decimal(18, 2)
  lineTotal       Decimal  @db.Decimal(18, 2)
  vatApplied      Boolean?
  vatAmount       Decimal? @db.Decimal(18, 2)
  priceSource     String   @default("default")
  createdAt       DateTime @default(now())
  grossQty        Decimal? @db.Decimal(18, 3)
  tareQty         Decimal? @db.Decimal(18, 3)
  tareReason      String?
  deductionQty    Decimal? @db.Decimal(18, 3)
  deductionReason String?
  product         Product  @relation(fields: [productId], references: [id])
  purchase        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, purchaseId])
  @@index([tenantId, productId])
}

model Sale {
  id                          String                  @id @default(uuid())
  tenantId                    String
  refNumber                   String
  buyerId                     String?
  buyerName                   String?
  buyerIdNumber               String?
  buyerPhone                  String?
  status                      TxStatus                @default(completed)
  totalAmount                 Decimal                 @db.Decimal(18, 2)
  vatAmount                   Decimal                 @default(0) @db.Decimal(18, 2)
  paymentMethod               PaymentMethod           @default(cash)
  notes                       String?
  voidedAt                    DateTime?
  voidedById                  String?
  voidReason                  String?
  createdByUserId             String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  customerId                  String?
  photoR2Key                  String?
  amountPaid                  Decimal?                @db.Decimal(18, 2)
  hasOutstandingBalance       Boolean                 @default(false)
  photoR2Keys                 String[]                @default([])
  businessLoanDeductionAmount Decimal?                @db.Decimal(18, 2)
  splitPayments               Json?
  customer                    Customer?               @relation("SaleCustomer", fields: [customerId], references: [id])
  lines                       SaleLine[]
  payments                    Payment[]
  businessLoanRepayments      BusinessLoanRepayment[]

  @@unique([tenantId, refNumber])
  @@index([tenantId])
  @@index([tenantId, buyerId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model SaleLine {
  id              String   @id @default(uuid())
  tenantId        String
  saleId          String
  productId       String
  quantity        Decimal  @db.Decimal(18, 3)
  unitPrice       Decimal  @db.Decimal(18, 2)
  lineTotal       Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  deductionQty    Decimal? @db.Decimal(18, 3)
  deductionReason String?
  grossQty        Decimal? @db.Decimal(18, 3)
  tareQty         Decimal? @db.Decimal(18, 3)
  tareReason      String?
  product         Product  @relation(fields: [productId], references: [id])
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, saleId])
  @@index([tenantId, productId])
}

model StockMovement {
  id              String         @id @default(uuid())
  tenantId        String
  productId       String
  direction       StockDirection
  quantity        Decimal        @db.Decimal(18, 3)
  source          String
  sourceId        String?
  notes           String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  product         Product        @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, direction])
  @@index([tenantId, source])
  @@index([tenantId, createdAt])
  @@index([tenantId, productId, createdAt])
}

model Payment {
  id              String        @id @default(uuid())
  tenantId        String
  refNumber       String
  customerId      String?
  amount          Decimal       @db.Decimal(18, 2)
  paymentMethod   PaymentMethod @default(cash)
  notes           String?
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  // Money direction — 'sale' = received from a buyer settling a sale;
  // 'purchase' = paid out to a supplier/customer settling a purchase (the
  // manual "Record Payment" action is purchase-direction too, since it
  // settles what the yard owes from purchases). Always set explicitly by
  // the writer (markSalePaid / markPurchasePaid / processSplitPayment /
  // createPayment) — never inferred from `notes` at read time.
  source          PaymentSource @default(purchase)
  saleId          String?
  purchaseId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  sale            Sale?         @relation(fields: [saleId], references: [id])
  purchase        Purchase?     @relation(fields: [purchaseId], references: [id])

  @@unique([tenantId, refNumber])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@index([tenantId, source])
  @@index([tenantId, saleId])
  @@index([tenantId, purchaseId])
}

// A day's MoMo (mobile money) wallet statement, exported as CSV from the
// provider's portal and uploaded by the cashier. Purely a reconciliation
// aid — sits alongside CashUp, never feeds its formula — so a manager can
// visually confirm "the MoMo statement's totals match what the system
// recorded for the day" during cash-up, without the system trying to
// auto-match individual transactions to Purchases/Sales/Payments.
model MomoStatementImport {
  id                String   @id @default(uuid())
  tenantId          String
  fileName          String
  statementDate     DateTime @db.Date
  totalSent         Decimal  @db.Decimal(18, 2)
  totalReceived     Decimal  @db.Decimal(18, 2)
  totalFees         Decimal  @db.Decimal(18, 2)
  transactionCount  Int
  failedCount       Int      @default(0)
  openingBalance    Decimal? @db.Decimal(18, 2)
  closingBalance    Decimal? @db.Decimal(18, 2)
  r2Key             String?
  uploadedByUserId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lines             MomoStatementLine[]

  @@unique([tenantId, statementDate])
  @@index([tenantId])
  @@index([tenantId, statementDate])
}

model MomoStatementLine {
  id              String              @id @default(uuid())
  tenantId        String
  importId        String
  externalTxnId   String?
  transactionDate DateTime
  status          String
  type            String
  fromName        String?
  toName          String?
  toMessage       String?
  amount          Decimal             @db.Decimal(18, 2)
  fee             Decimal             @default(0) @db.Decimal(18, 2)
  balance         Decimal?            @db.Decimal(18, 2)
  createdAt       DateTime            @default(now())
  import          MomoStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, importId])
}

model ExpenseType {
  id        String        @id @default(uuid())
  tenantId  String
  name      String
  parentId  String?
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  expenses  Expense[]
  parent    ExpenseType?  @relation("children", fields: [parentId], references: [id])
  children  ExpenseType[] @relation("children")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, parentId])
}

model Expense {
  id              String              @id @default(uuid())
  tenantId        String
  refNumber       String
  expenseTypeId   String
  description     String
  amount          Decimal             @db.Decimal(18, 2)
  estimatedAmount Decimal?            @db.Decimal(18, 2)
  changeReceived  Decimal?            @db.Decimal(18, 2)
  vatAmount       Decimal             @default(0) @db.Decimal(18, 2)
  includesVat     Boolean             @default(false)
  paymentMethod   PaymentMethod       @default(cash)
  chequeNo        String?
  status          ExpenseStatus       @default(pending)
  approvedById    String?
  approvedAt      DateTime?
  voidedById      String?
  voidedAt        DateTime?
  voidReason      String?
  cashUpId        String?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  expenseType     ExpenseType         @relation(fields: [expenseTypeId], references: [id])
  attachments     ExpenseAttachment[]

  @@unique([tenantId, refNumber])
  @@index([tenantId])
  @@index([tenantId, expenseTypeId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model ExpenseAttachment {
  id               String   @id @default(uuid())
  tenantId         String
  expenseId        String
  r2Key            String
  fileName         String
  notes            String?
  uploadedAt       DateTime @default(now())
  uploadedByUserId String?
  expense          Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, expenseId])
}

model CashFloat {
  id              String          @id @default(uuid())
  tenantId        String
  floatDate       DateTime        @db.Date
  openingAmount   Decimal         @db.Decimal(18, 2)
  closingAmount   Decimal?        @db.Decimal(18, 2)
  notes           String?
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  movements       FloatMovement[]

  @@unique([tenantId, floatDate])
  @@index([tenantId])
  @@index([tenantId, floatDate])
}

model Stocktake {
  id              String           @id @default(uuid())
  tenantId        String
  refNumber       String
  status          StocktakeStatus  @default(open)
  notes           String?
  createdByUserId String
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  stockSnapshot   Json?
  voidReason      String?
  voidedAt        DateTime?
  voidedByUserId  String?
  createdBy       User             @relation("StocktakeCreatedBy", fields: [createdByUserId], references: [id])
  voidedBy        User?            @relation("StocktakeVoidedBy", fields: [voidedByUserId], references: [id])
  entries         StocktakeEntry[]

  @@unique([tenantId, refNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model StocktakeEntry {
  id          String    @id @default(uuid())
  tenantId    String
  stocktakeId String
  productId   String
  systemQty   Decimal   @db.Decimal(18, 4)
  countedQty  Decimal   @db.Decimal(18, 4)
  variance    Decimal   @db.Decimal(18, 4)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  grossQty    Decimal?  @db.Decimal(18, 4)
  tareQty     Decimal?  @db.Decimal(18, 4)
  photoR2Key  String?
  product     Product   @relation(fields: [productId], references: [id])
  stocktake   Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, stocktakeId, productId])
  @@index([tenantId])
  @@index([tenantId, stocktakeId])
  @@index([tenantId, productId])
}

model CashUp {
  id                  String       @id @default(uuid())
  tenantId            String
  sessionDate         DateTime     @db.Date
  currency            Currency     @default(ZAR)
  openedByUserId      String
  openedAt            DateTime     @default(now())
  closedByUserId      String?
  closedAt            DateTime?
  approvedByUserId    String?
  approvedAt          DateTime?
  status              CashUpStatus @default(open)
  systemCashSales     Decimal      @default(0) @db.Decimal(18, 2)
  systemCashPurchases Decimal      @default(0) @db.Decimal(18, 2)
  systemCashPayments  Decimal      @default(0) @db.Decimal(18, 2)
  systemCashExpected  Decimal      @default(0) @db.Decimal(18, 2)
  openingBalance      Decimal      @default(0) @db.Decimal(18, 2)
  drawingsReceived    Decimal      @default(0) @db.Decimal(18, 2)
  expensesTotal       Decimal      @default(0) @db.Decimal(18, 2)
  cardPaymentsTotal   Decimal      @default(0) @db.Decimal(18, 2)
  loansTotal          Decimal      @default(0) @db.Decimal(18, 2)
  finPeriodCumulative Decimal      @default(0) @db.Decimal(18, 2)
  declaredCash        Decimal?     @db.Decimal(18, 2)
  variance            Decimal?     @db.Decimal(18, 2)
  notes               String?
  denominations       Json?
  rejectedByUserId    String?
  rejectedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // A day can hold more than one session (separate shifts) — sessionDate is
  // NOT unique per tenant. The real invariant, "at most one session may be
  // 'open' at a time", is enforced by a partial unique index that Prisma's
  // schema DSL can't express directly (declared via raw SQL only — see
  // migration 20260724000000_cashup_multi_session_per_day, same pattern as
  // the RLS policies in 20260716000003_enable_rls):
  //   CREATE UNIQUE INDEX "CashUp_tenantId_one_open_key"
  //     ON "CashUp"("tenantId") WHERE status = 'open';
  @@index([tenantId, sessionDate])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, openedByUserId])
}

