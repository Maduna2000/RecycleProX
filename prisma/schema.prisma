model ScaleOrder {
  id              String           @id @default(uuid())
  tenantId        String
  orderNumber     String
  customerId      String?
  productId       String
  weight          Decimal?         @db.Decimal(18, 3)
  photoR2Keys     String[]
  slipR2Key       String?
  status          ScaleOrderStatus @default(pending)
  operatorId      String
  notes           String?
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  casualFirstName String?
  casualLastName  String?
  casualPhone     String?
  lineCount       Int              @default(1)
  casualIdNumber  String?
  // Traceability back to the Gate visit this order was started from, when the
  // operator resolved the customer via a queue number rather than ID/search.
  gateEntryId     String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  operator        User             @relation("ScaleOrderOperator", fields: [operatorId], references: [id])
  product         Product          @relation("ScaleOrderProduct", fields: [productId], references: [id])
  voidedBy        User?            @relation("ScaleOrderVoidedBy", fields: [voidedById], references: [id])
  gateEntry       GateEntry?       @relation(fields: [gateEntryId], references: [id])
  lines           ScaleOrderLine[]
  purchase        Purchase?

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, productId])
  @@index([tenantId, operatorId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, gateEntryId])
}

