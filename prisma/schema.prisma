generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(uuid())
  fullName            String
  username            String             @unique
  passwordHash        String
  pinHash             String?
  role                UserRole
  isActive            Boolean            @default(true)
  forcePasswordChange Boolean            @default(true)
  failedAttempts      Int                @default(0)
  lockedAt            DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  createdByUserId     String?
  operatedScaleOrders ScaleOrder[]       @relation("ScaleOrderOperator")
  voidedScaleOrders   ScaleOrder[]       @relation("ScaleOrderVoidedBy")
  stocktakes          Stocktake[]        @relation("StocktakeCreatedBy")
  voidedStocktakes    Stocktake[]        @relation("StocktakeVoidedBy")
  moduleAccess        UserModuleAccess[]
}

model UserModuleAccess {
  id          String   @id @default(uuid())
  userId      String
  moduleKey   String
  grantedById String?
  grantedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleKey])
  @@index([userId])
  @@index([moduleKey])
}

model AuditLog {
  id          BigInt      @id @default(autoincrement())
  tableName   String
  recordId    String
  action      AuditAction
  oldValues   Json?
  newValues   Json?
  changedById String?
  ipAddress   String?
  userAgent   String?
  rowHash     String
  createdAt   DateTime    @default(now())

  @@index([tableName, recordId])
  @@index([changedById])
  @@index([createdAt])
}

model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Customer {
  id                  String               @id @default(uuid())
  customerType        CustomerType         @default(casual)
  primaryFunction     PrimaryFunction      @default(supplier)
  idNumber            String?              @unique
  firstName           String
  lastName            String
  dateOfBirth         DateTime?
  gender              Gender?
  nationality         String?
  companyName         String?
  contactPerson       String?
  phone               String
  email               String?
  physicalAddress     String?
  postalAddress       String?
  vatNumber           String?
  bankName            String?
  bankAccountNo       String?
  bankBranchCode      String?
  creditLimit         Decimal?             @db.Decimal(18, 2)
  policeRegisterNo    String?
  licenseNumber       String?
  licenseExpiry       DateTime?
  tradeCommodities    Json?
  customerNotes       String?
  idPhotoR2Key        String?
  priceGroupId        String?
  isActive            Boolean              @default(true)
  blacklisted         Boolean              @default(false)
  blacklistReason     String?
  blacklistedAt       DateTime?
  blacklistedById     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  createdByUserId     String?
  dealerCategory      DealerCategory?
  marketSector        MarketSector?
  zeroRated           Boolean              @default(false)
  accountCode         String?              @unique
  companyRegNumber    String?
  landline            String?
  priceGroup          PriceGroup?          @relation(fields: [priceGroupId], references: [id])
  documents           CustomerDocument[]
  loans               Loan[]
  loanRepayments      LoanRepayment[]
  payments            Payment[]
  purchases           Purchase[]
  sales               Sale[]               @relation("SaleCustomer")
  scaleOrders         ScaleOrder[]
  transactionPayments TransactionPayment[]

  @@index([idNumber])
  @@index([phone])
  @@index([lastName])
  @@index([customerType])
  @@index([companyName])
  @@index([contactPerson])
}

model CustomerDocument {
  id               String               @id @default(uuid())
  customerId       String
  documentType     CustomerDocumentType
  r2Key            String
  fileName         String
  notes            String?
  uploadedAt       DateTime             @default(now())
  uploadedByUserId String?
  customer         Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Product {
  id               String                      @id @default(uuid())
  code             String                      @unique
  name             String
  category         String
  unit             UnitOfMeasure               @default(kg)
  defaultBuyPrice  Decimal                     @db.Decimal(18, 2)
  defaultSellPrice Decimal                     @db.Decimal(18, 2)
  isActive         Boolean                     @default(true)
  sortOrder        Int                         @default(0)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  minStockLevel    Decimal?                    @db.Decimal(18, 3)
  buyMarginPct     Decimal?                    @db.Decimal(8, 4)
  priceOverrides   PriceGroupProductOverride[]
  priceHistory     PriceHistory[]
  purchaseLines    PurchaseLine[]
  saleLines        SaleLine[]
  scaleOrders      ScaleOrder[]                @relation("ScaleOrderProduct")
  scaleOrderLines  ScaleOrderLine[]            @relation("ScaleOrderLineProduct")
  stockMovements   StockMovement[]
  stocktakeEntries StocktakeEntry[]

  @@index([category])
  @@index([isActive])
}

model PriceGroup {
  id          String                      @id @default(uuid())
  name        String                      @unique
  description String?
  isDefault   Boolean                     @default(false)
  isActive    Boolean                     @default(true)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  customers   Customer[]
  overrides   PriceGroupProductOverride[]
}

model PriceGroupProductOverride {
  id           String     @id @default(uuid())
  priceGroupId String
  productId    String
  buyPrice     Decimal    @db.Decimal(18, 2)
  sellPrice    Decimal    @db.Decimal(18, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  priceGroup   PriceGroup @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceGroupId, productId])
  @@index([productId])
}

model PriceHistory {
  id          String   @id @default(uuid())
  productId   String
  buyPrice    Decimal  @db.Decimal(18, 2)
  sellPrice   Decimal  @db.Decimal(18, 2)
  changedById String?
  reason      String?
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

model ProductCategory {
  id         String              @id @default(uuid())
  name       String              @unique
  colorHex   String?
  sortOrder  Int                 @default(0)
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  iconName   String?
  parentId   String?
  stepConfig CategoryStepConfig?
  parent     ProductCategory?    @relation("SubCategories", fields: [parentId], references: [id])
  children   ProductCategory[]   @relation("SubCategories")
}

model TradeCommodityCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model CategoryStepConfig {
  id              String          @id @default(uuid())
  categoryId      String          @unique
  requireWeight   Boolean         @default(true)
  requirePhotos   Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdByUserId String?
  category        ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Purchase {
  id                      String                   @id @default(uuid())
  refNumber               String                   @unique
  customerId              String
  status                  TxStatus                 @default(completed)
  totalAmount             Decimal                  @db.Decimal(18, 2)
  paymentMethod           PaymentMethod            @default(cash)
  notes                   String?
  voidedAt                DateTime?
  voidedById              String?
  voidReason              String?
  createdByUserId         String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  signatureR2Key          String?
  vat264R2Key             String?
  loanDeductionAmount     Decimal?                 @db.Decimal(18, 2)
  photoR2Keys             String[]
  amountPaid              Decimal                  @default(0) @db.Decimal(18, 2)
  hasOutstandingBalance   Boolean                  @default(false)
  pdfEmailed              Boolean                  @default(false)
  purchaseNoteR2Key       String?
  vehicleReg              String?
  wbTicketNumber          String?
  splitPayments           Json?
  loanRepayments          LoanRepayment[]
  customer                Customer                 @relation(fields: [customerId], references: [id])
  lines                   PurchaseLine[]
  transactionPaymentLinks TransactionPaymentLink[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([refNumber])
  @@index([customerId, status, createdAt])
}

model PurchaseLine {
  id              String   @id @default(uuid())
  purchaseId      String
  productId       String
  quantity        Decimal  @db.Decimal(18, 3)
  unitPrice       Decimal  @db.Decimal(18, 2)
  lineTotal       Decimal  @db.Decimal(18, 2)
  priceSource     String   @default("default")
  createdAt       DateTime @default(now())
  grossQty        Decimal? @db.Decimal(18, 3)
  tareQty         Decimal? @db.Decimal(18, 3)
  tareReason      String?
  deductionQty    Decimal? @db.Decimal(18, 3)
  deductionReason String?
  product         Product  @relation(fields: [productId], references: [id])
  purchase        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
}

model Sale {
  id                    String        @id @default(uuid())
  refNumber             String        @unique
  buyerId               String?
  buyerName             String?
  buyerIdNumber         String?
  buyerPhone            String?
  status                TxStatus      @default(completed)
  totalAmount           Decimal       @db.Decimal(18, 2)
  paymentMethod         PaymentMethod @default(cash)
  notes                 String?
  voidedAt              DateTime?
  voidedById            String?
  voidReason            String?
  createdByUserId       String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  customerId            String?
  photoR2Key            String?
  amountPaid            Decimal?      @db.Decimal(18, 2)
  hasOutstandingBalance Boolean       @default(false)
  photoR2Keys           String[]      @default([])
  customer              Customer?     @relation("SaleCustomer", fields: [customerId], references: [id])
  lines                 SaleLine[]

  @@index([buyerId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([refNumber])
}

model SaleLine {
  id              String   @id @default(uuid())
  saleId          String
  productId       String
  quantity        Decimal  @db.Decimal(18, 3)
  unitPrice       Decimal  @db.Decimal(18, 2)
  lineTotal       Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  deductionQty    Decimal? @db.Decimal(18, 3)
  deductionReason String?
  grossQty        Decimal? @db.Decimal(18, 3)
  tareQty         Decimal? @db.Decimal(18, 3)
  tareReason      String?
  product         Product  @relation(fields: [productId], references: [id])
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

model StockMovement {
  id              String         @id @default(uuid())
  productId       String
  direction       StockDirection
  quantity        Decimal        @db.Decimal(18, 3)
  source          String
  sourceId        String?
  notes           String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  product         Product        @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([direction])
  @@index([source])
  @@index([createdAt])
  @@index([productId, createdAt])
}

model Payment {
  id              String        @id @default(uuid())
  refNumber       String        @unique
  customerId      String?
  amount          Decimal       @db.Decimal(18, 2)
  paymentMethod   PaymentMethod @default(cash)
  notes           String?
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        Customer?     @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([createdAt])
  @@index([refNumber])
}

model ExpenseType {
  id        String        @id @default(uuid())
  name      String        @unique
  parentId  String?
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  expenses  Expense[]
  parent    ExpenseType?  @relation("children", fields: [parentId], references: [id])
  children  ExpenseType[] @relation("children")

  @@index([parentId])
}

model Expense {
  id              String              @id @default(uuid())
  refNumber       String              @unique
  expenseTypeId   String
  description     String
  amount          Decimal             @db.Decimal(18, 2)
  estimatedAmount Decimal?            @db.Decimal(18, 2)
  changeReceived  Decimal?            @db.Decimal(18, 2)
  vatAmount       Decimal             @default(0) @db.Decimal(18, 2)
  includesVat     Boolean             @default(false)
  paymentMethod   PaymentMethod       @default(cash)
  chequeNo        String?
  status          ExpenseStatus       @default(pending)
  approvedById    String?
  approvedAt      DateTime?
  cashUpId        String?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  expenseType     ExpenseType         @relation(fields: [expenseTypeId], references: [id])
  attachments     ExpenseAttachment[]

  @@index([expenseTypeId])
  @@index([status])
  @@index([createdAt])
}

model ExpenseAttachment {
  id               String   @id @default(uuid())
  expenseId        String
  r2Key            String
  fileName         String
  notes            String?
  uploadedAt       DateTime @default(now())
  uploadedByUserId String?
  expense          Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model CashFloat {
  id              String          @id @default(uuid())
  floatDate       DateTime        @unique @db.Date
  openingAmount   Decimal         @db.Decimal(18, 2)
  closingAmount   Decimal?        @db.Decimal(18, 2)
  notes           String?
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  movements       FloatMovement[]

  @@index([floatDate])
}

model Stocktake {
  id              String           @id @default(uuid())
  refNumber       String           @unique
  status          StocktakeStatus  @default(open)
  notes           String?
  createdByUserId String
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  stockSnapshot   Json?
  voidReason      String?
  voidedAt        DateTime?
  voidedByUserId  String?
  createdBy       User             @relation("StocktakeCreatedBy", fields: [createdByUserId], references: [id])
  voidedBy        User?            @relation("StocktakeVoidedBy", fields: [voidedByUserId], references: [id])
  entries         StocktakeEntry[]

  @@index([status])
  @@index([createdAt])
}

model StocktakeEntry {
  id          String    @id @default(uuid())
  stocktakeId String
  productId   String
  systemQty   Decimal   @db.Decimal(18, 4)
  countedQty  Decimal   @db.Decimal(18, 4)
  variance    Decimal   @db.Decimal(18, 4)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  grossQty    Decimal?  @db.Decimal(18, 4)
  tareQty     Decimal?  @db.Decimal(18, 4)
  photoR2Key  String?
  product     Product   @relation(fields: [productId], references: [id])
  stocktake   Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)

  @@unique([stocktakeId, productId])
  @@index([stocktakeId])
  @@index([productId])
}

model CashUp {
  id                  String       @id @default(uuid())
  sessionDate         DateTime     @db.Date
  currency            Currency     @default(ZAR)
  openedByUserId      String
  openedAt            DateTime     @default(now())
  closedByUserId      String?
  closedAt            DateTime?
  approvedByUserId    String?
  approvedAt          DateTime?
  status              CashUpStatus @default(open)
  systemCashSales     Decimal      @default(0) @db.Decimal(18, 2)
  systemCashPurchases Decimal      @default(0) @db.Decimal(18, 2)
  systemCashPayments  Decimal      @default(0) @db.Decimal(18, 2)
  systemCashExpected  Decimal      @default(0) @db.Decimal(18, 2)
  openingBalance      Decimal      @default(0) @db.Decimal(18, 2)
  drawingsReceived    Decimal      @default(0) @db.Decimal(18, 2)
  expensesTotal       Decimal      @default(0) @db.Decimal(18, 2)
  cardPaymentsTotal   Decimal      @default(0) @db.Decimal(18, 2)
  loansTotal          Decimal      @default(0) @db.Decimal(18, 2)
  finPeriodCumulative Decimal      @default(0) @db.Decimal(18, 2)
  declaredCash        Decimal?     @db.Decimal(18, 2)
  variance            Decimal?     @db.Decimal(18, 2)
  notes               String?
  denominations       Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([sessionDate])
  @@index([status])
  @@index([openedByUserId])
}

model Loan {
  id              String          @id @default(uuid())
  refNumber       String          @unique
  customerId      String
  principalAmount Decimal         @db.Decimal(18, 2)
  balanceAmount   Decimal         @db.Decimal(18, 2)
  paymentMethod   PaymentMethod   @default(cash)
  notes           String?
  status          LoanStatus      @default(active)
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  customer        Customer        @relation(fields: [customerId], references: [id])
  repayments      LoanRepayment[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model LoanRepayment {
  id              String        @id @default(uuid())
  refNumber       String        @unique
  loanId          String
  customerId      String
  amount          Decimal       @db.Decimal(18, 2)
  paymentMethod   PaymentMethod @default(cash)
  notes           String?
  createdByUserId String?
  createdAt       DateTime      @default(now())
  purchaseId      String?
  customer        Customer      @relation(fields: [customerId], references: [id])
  loan            Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  purchase        Purchase?     @relation(fields: [purchaseId], references: [id])

  @@index([loanId])
  @@index([customerId])
  @@index([purchaseId])
  @@index([createdAt])
}

model PoliceVisit {
  id              String   @id @default(uuid())
  visitDate       DateTime @db.Date
  officerName     String
  badgeNumber     String?
  stationName     String?
  registerR2Key   String?
  signatureR2Key  String?
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([visitDate])
  @@index([createdAt])
}

model MediaFile {
  id               String   @id @default(uuid())
  r2Key            String   @unique
  fileName         String
  mimeType         String
  fileSizeBytes    Int?
  linkedModel      String
  linkedId         String
  mediaType        String
  uploadedByUserId String?
  uploadedAt       DateTime @default(now())

  @@index([linkedModel, linkedId])
  @@index([uploadedAt])
}

model FloatMovement {
  id              String            @id @default(uuid())
  cashFloatId     String
  movementType    FloatMovementType
  amount          Decimal           @db.Decimal(18, 2)
  balanceAfter    Decimal           @db.Decimal(18, 2)
  referenceNote   String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  cashFloat       CashFloat         @relation(fields: [cashFloatId], references: [id], onDelete: Cascade)

  @@index([cashFloatId])
  @@index([createdAt])
}

model TransactionPayment {
  id              String                   @id @default(uuid())
  refNumber       String                   @unique
  customerId      String
  totalAmount     Decimal                  @db.Decimal(18, 2)
  paymentMethod   PaymentMethod            @default(cash)
  notes           String?
  createdByUserId String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  customer        Customer                 @relation(fields: [customerId], references: [id])
  purchaseLinks   TransactionPaymentLink[]

  @@index([customerId])
  @@index([createdAt])
}

model TransactionPaymentLink {
  id                   String             @id @default(uuid())
  transactionPaymentId String
  purchaseId           String
  amountAllocated      Decimal            @db.Decimal(18, 2)
  createdAt            DateTime           @default(now())
  purchase             Purchase           @relation(fields: [purchaseId], references: [id])
  transactionPayment   TransactionPayment @relation(fields: [transactionPaymentId], references: [id], onDelete: Cascade)

  @@unique([transactionPaymentId, purchaseId])
  @@index([purchaseId])
}

model ScaleOrder {
  id              String           @id @default(uuid())
  orderNumber     String           @unique
  customerId      String?
  productId       String
  weight          Decimal?         @db.Decimal(18, 3)
  photoR2Keys     String[]
  slipR2Key       String?
  status          ScaleOrderStatus @default(pending)
  operatorId      String
  notes           String?
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  casualFirstName String?
  casualLastName  String?
  casualPhone     String?
  lineCount       Int              @default(1)
  casualIdNumber  String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  operator        User             @relation("ScaleOrderOperator", fields: [operatorId], references: [id])
  product         Product          @relation("ScaleOrderProduct", fields: [productId], references: [id])
  voidedBy        User?            @relation("ScaleOrderVoidedBy", fields: [voidedById], references: [id])
  lines           ScaleOrderLine[]

  @@index([customerId])
  @@index([productId])
  @@index([operatorId])
  @@index([status])
  @@index([createdAt])
}

model ScaleOrderLine {
  id          String     @id @default(uuid())
  orderId     String
  productId   String
  weight      Decimal?   @db.Decimal(18, 3)
  photoR2Keys String[]
  createdAt   DateTime   @default(now())
  order       ScaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product    @relation("ScaleOrderLineProduct", fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

enum UserRole {
  admin
  manager
  cashier
  scale_operator
}

enum ScaleOrderStatus {
  pending
  processed
  voided
}

enum CustomerType {
  casual
  account
}

enum TxStatus {
  pending
  completed
  voided
}

enum PaymentMethod {
  cash
  eft
  cheque
}

enum UnitOfMeasure {
  kg
  ton
  each
  litre
}

enum StockDirection {
  in
  out
}

enum PrimaryFunction {
  customer
  supplier
  both
}

enum Gender {
  male
  female
  other
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
  VOID
  LOGIN
  LOGOUT
  PRINT
  EXPORT
  ADJUSTMENT
}

enum MarketSector {
  formal
  informal
}

enum DealerCategory {
  casual
  dealer_1
  dealer_2
  dealer_3
}

enum CustomerDocumentType {
  trading_licence
  sars_certificate
  company_registration
  id_copy
  other
}

enum FloatMovementType {
  opening
  top_up
  withdrawal
  adjustment
}

enum ExpenseStatus {
  pending
  approved
  voided
}

enum CashUpStatus {
  open
  submitted
  approved
  voided
}

enum Currency {
  ZAR  // South African Rand (R)
  SZL  // Eswatini Lilangeni (E)
}

enum StocktakeStatus {
  open
  completed
  voided
}

enum LoanStatus {
  active
  settled
  voided
}
