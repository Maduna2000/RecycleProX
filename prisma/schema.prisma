// A dealer (account customer) advances the business cash to buy stock — the
// reverse of Loan/LoanRepayment above (business owes the dealer, not the
// other way around). Kept as a fully separate model rather than a
// `direction` flag on Loan: the amount on this one is admin-only-visible
// (see businessLoanService.ts), and isolating that masking logic from the
// existing, unrestricted Loan feature keeps the blast radius of a bug in
// either one contained to itself.
model BusinessLoan {
  id              String                  @id @default(uuid())
  tenantId        String
  refNumber       String
  customerId      String
  principalAmount Decimal                 @db.Decimal(18, 2)
  balanceAmount   Decimal                 @db.Decimal(18, 2)
  paymentMethod   PaymentMethod           @default(cash)
  notes           String?
  status          BusinessLoanStatus      @default(active)
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  createdByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  customer        Customer                @relation(fields: [customerId], references: [id])
  repayments      BusinessLoanRepayment[]

  @@unique([tenantId, refNumber])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model BusinessLoanRepayment {
  id              String        @id @default(uuid())
  tenantId        String
  refNumber       String
  businessLoanId  String
  customerId      String
