# Renovo Pro — Local Hardware-Bridge Server environment
#
# Copy this file to "local-server.env" (same folder) and fill in real
# values. That file is never committed to git — keep it that way, it holds
# production database credentials.
#
# Where to find the real values: Vercel dashboard -> the "RecycleProX"
# project -> Settings -> Environment Variables. Copy each value shown as
# "Sensitive" by clicking the eye icon there (they cannot be retrieved any
# other way, including by Claude/CLI tooling).

# ── Load-bearing — login and the printer/scale workflow will not work without these ──

# The SAME restricted "app_runtime" connection string Vercel uses — NEVER
# the Neon owner/admin connection string. The owner role has BYPASSRLS,
# which would silently defeat tenant data isolation. Set to the IDENTICAL
# value in both of these two variables — two different code paths
# (registryPrisma.ts and src/lib/db/prisma.ts) each read one of them.
DATABASE_URL=
APP_RUNTIME_DATABASE_URL=

# Generate a FRESH value for this file — do not paste Vercel's AUTH_SECRET.
# A separate secret per local install means a leaked local file can only
# forge sessions against this local server, not against the production URL
# too. Generate one with: openssl rand -hex 32
AUTH_SECRET=

# Copy these exact values from Vercel. Every login (including the default
# tenant's own login, not just subdomain-routed ones) checks company access
# against the Portal using these — leaving them blank works for about a day
# (a cached fail-open window) and then silently rejects every login.
RENOVO_PORTAL_BASE_URL=
INTERNAL_API_SHARED_SECRET=

# Local server port and bind address. 127.0.0.1 (loopback-only) is
# deliberate: it satisfies the browser's PWA install requirement (localhost
# is exempt from the HTTPS "secure context" rule) and keeps this server
# unreachable from the rest of the shop's network, since it holds
# production database credentials.
PORT=3200
HOSTNAME=127.0.0.1
NODE_ENV=production

# ── Conditional — only needed if this station's purchase flow captures ID photos/documents ──
# Copy from Vercel if used; otherwise leave blank.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Leave these unset — do not add them ──
# TENANT_BASE_DOMAIN   — only matters for subdomain-based tenant routing,
#                         irrelevant when visiting 127.0.0.1.
# DATABASE_PROVIDER    — must stay unset. This is the Electron desktop
#                         build's SQLite-mode flag; this local-server mode
#                         always uses the standard Postgres path.
# RESEND_API_KEY       — present in package.json but not actually used
#                         anywhere in the app today.
