{
  "name": "renovopro",
  "version": "0.2.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "npx ts-node --project tsconfig.scripts.json scripts/check-tenant-wrapping.ts && prisma generate && prisma migrate deploy && next build",
    "check:tenant-wrapping": "npx ts-node --project tsconfig.scripts.json scripts/check-tenant-wrapping.ts",
    "start": "next start",
    "lint": "next lint",
    "seed": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "migrate:permissions": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/migrate-user-permissions.ts",
    "migrate:tenants": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/migrate-tenants.ts",
    "generate:sqlite": "npx ts-node scripts/generate-sqlite-schema.ts && prisma generate --schema=prisma/sqlite/schema.prisma",
    "migrate:sqlite:deploy": "prisma migrate deploy --schema=prisma/sqlite/schema.prisma",
    "electron": "electron .",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build:desktop": "npx ts-node scripts/build-desktop-postgres.ts",
    "electron:build": "npm run build:desktop && electron-builder --publish=never",
    "build:desktop:sqlite": "npx ts-node scripts/build-desktop.ts",
    "package:local-server": "npx ts-node scripts/local-server/assemble.ts"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  },
  "build": {
    "appId": "za.co.goldenkey.renovopro",
    "productName": "Renovo Pro",
    "asar": false,
    "publish": [
      {
        "provider": "generic",
        "url": "${env.DESKTOP_UPDATE_FEED_BASE_URL}/api/desktop/update-feed",
        "channel": "latest"
      }
    ],
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      },
      {
        "from": ".next/standalone/node_modules/.prisma",
        "to": "app/.next/standalone/node_modules/.prisma"
      },
      {
        "from": ".next/standalone/node_modules/@prisma/client",
        "to": "app/.next/standalone/node_modules/@prisma/client"
      },
      {
        "from": ".next/standalone/node_modules/@prisma/engines",
        "to": "app/.next/standalone/node_modules/@prisma/engines"
      },
      {
        "from": ".next/standalone/node_modules/serialport",
        "to": "app/.next/standalone/node_modules/serialport"
      },
      {
        "from": ".next/standalone/node_modules/@serialport",
        "to": "app/.next/standalone/node_modules/@serialport"
      },
      {
        "from": ".next/standalone/node_modules/node-thermal-printer",
        "to": "app/.next/standalone/node_modules/node-thermal-printer"
      },
      {
        "from": ".next/standalone/node_modules/next",
        "to": "app/.next/standalone/node_modules/next"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  },
  "prisma": {
    "seed": "npx ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@serialport/parser-readline": "^13.0.0",
    "@tanstack/react-query": "^5.96.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.7.0",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.30",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "node-thermal-printer": "^4.6.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.72.1",
    "resend": "^6.10.0",
    "serialport": "^13.0.0",
    "shadcn": "^4.1.2",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^5.1.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.5"
  }
}
