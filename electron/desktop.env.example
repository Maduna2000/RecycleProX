# Renovo Pro Desktop — production connection config
#
# This file is normally written AUTOMATICALLY by the app itself the moment
# device activation succeeds (electron/main.js's writeDesktopEnv(), fed by
# the runtimeConfig the Portal's POST /api/desktop/activate response now
# includes) — you should not need to touch this file by hand for a normal
# install. It lives at the app's userData folder as "desktop.env" (Windows:
# %APPDATA%\renovopro\desktop.env — the folder name comes from package.json's
# top-level "name" field). Never commit the real file — it holds production
# database credentials.
#
# This example file is for the manual fallback path only: unattended
# provisioning via scripts/desktop/provision-till.ps1 pre-seeding from a
# network share, or a support scenario where a value needs hand-editing.
# Where to find the real values manually: Vercel dashboard -> the
# "RecycleProX" project -> Settings -> Environment Variables. Copy each
# value shown as "Sensitive" by clicking the eye icon there (they cannot be
# retrieved any other way, including by Claude/CLI tooling). Same values
# used by scripts/local-server/local-server.env — see that file's own
# comments too.

# The SAME restricted "app_runtime" connection string Vercel uses — NEVER
# the Neon owner/admin connection string. The owner role has BYPASSRLS,
# which would silently defeat tenant data isolation. Set to the IDENTICAL
# value in both of these two variables — two different code paths
# (registryPrisma.ts and src/lib/db/prisma.ts) each read one of them.
DATABASE_URL=
APP_RUNTIME_DATABASE_URL=

# Generate a FRESH value for this file — do not paste Vercel's AUTH_SECRET.
# A separate secret per install means a leaked local file can only forge
# sessions against this one desktop install, not against production too.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=

# Copy these exact values from Vercel. Every login (including the default
# tenant's own login) checks company access against the Portal using these —
# leaving them blank works for about a day (a cached fail-open window) and
# then silently rejects every login.
RENOVO_PORTAL_BASE_URL=
INTERNAL_API_SHARED_SECRET=

# ── Conditional — only needed if this station's purchase flow captures ID photos/documents ──
# Copy from Vercel if used; otherwise leave blank.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Leave unset — do not add ──
# DATABASE_PROVIDER — must stay unset. This build's Prisma client is the
#                      standard Postgres one; setting this would try to
#                      route SQLite-only query shapes at a Postgres DB.
