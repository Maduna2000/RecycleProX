.agents/
.claude/skills/
.trae/
.superpowers/
.windsurf/
.claude/scheduled_tasks.lock

# Mobile build artifacts
mobile/gradle_build*.log
mobile/android/build/
mobile/android/.gradle/
mobile/ios/build/
mobile/ios/Pods/
